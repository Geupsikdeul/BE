DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/geupsikdeul
DEBUG=true

# REQUIRED in any shared/prod environment. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
# Only real frontend origins (JSON list), never ["*"]
CORS_ORIGINS=["http://localhost:3000"]
# Allow PUT /polls/{id}/vote to change a vote before close
ALLOW_VOTE_CHANGE=true

# Optional: first admin created by prestart.sh (db/init_db.py) if not present
FIRST_ADMIN_LOGIN=
FIRST_ADMIN_NAME=
FIRST_ADMIN_PASSWORD=
